{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/runtime-release.schema.json",
  "title": "Deterministic runtime release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "content_version", "generated_at", "countries", "sources",
    "evidence_records", "pathways", "source_manifest_checksum"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "content_version": {"type": "string", "pattern": "\\S"},
    "generated_at": {"type": "string", "format": "date-time"},
    "candidate": {"type": "boolean"},
    "countries": {
      "type": "object",
      "patternProperties": {"^[A-Z]{3}$": {"type": "object"}},
      "additionalProperties": false,
      "minProperties": 1
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "source.schema.json#/$defs/source"}
    },
    "evidence_records": {"type": "array"},
    "pathways": {"type": "array"},
    "source_manifest_checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "1.0.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "not": {"required": ["candidate"]},
        "properties": {
          "countries": {
            "type": "object",
            "patternProperties": {
              "^[A-Z]{3}$": {"$ref": "#/$defs/countrySummary1_0"}
            },
            "additionalProperties": false,
            "minProperties": 1
          },
          "evidence_records": {
            "type": "array",
            "items": {"$ref": "#/$defs/evidence1_0"}
          },
          "pathways": {
            "type": "array",
            "items": {"$ref": "#/$defs/pathwayApproved"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "1.1.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["candidate"],
        "allOf": [
          {
            "if": {
              "properties": {"candidate": {"const": true}},
              "required": ["candidate"]
            },
            "then": {
              "properties": {
                "countries": {
                  "type": "object",
                  "patternProperties": {
                    "^[A-Z]{3}$": {
                      "$ref": "#/$defs/countrySummary1_1Candidate"
                    }
                  },
                  "additionalProperties": false,
                  "minProperties": 1
                },
                "evidence_records": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/evidence1_1Candidate"}
                },
                "pathways": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/pathwayCandidate"}
                }
              }
            },
            "else": {
              "properties": {
                "countries": {
                  "type": "object",
                  "patternProperties": {
                    "^[A-Z]{3}$": {
                      "$ref": "#/$defs/countrySummary1_1Promoted"
                    }
                  },
                  "additionalProperties": false,
                  "minProperties": 1
                },
                "evidence_records": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/evidence1_1Approved"}
                },
                "pathways": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/pathwayApproved"}
                }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "countrySummaryProperties": {
      "iso3": {"type": "string", "pattern": "^[A-Z]{3}$"},
      "name": {"type": "string", "pattern": "\\S"},
      "aliases": {
        "type": "array",
        "items": {"type": "string", "pattern": "\\S"},
        "uniqueItems": true
      },
      "reviewer": {"type": "string", "pattern": "\\S"},
      "reviewed_on": {"type": "string", "format": "date"},
      "review_due": {"type": "string", "format": "date"},
      "dossier_path": {
        "type": "string",
        "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])source_documents(?:[\\\\/]|$))\\S+$"
      },
      "evidence_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Z]{3}-E-[0-9]{3}$"
        },
        "uniqueItems": true
      },
      "pathway_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Z]{3}-P-[0-9]{3}$"
        },
        "uniqueItems": true
      },
      "decision_notes": {"type": "string", "pattern": "\\S"}
    },
    "countrySummary1_0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iso3", "name", "aliases", "status", "reviewer", "reviewed_on",
        "review_due", "dossier_path", "evidence_ids", "pathway_ids",
        "decision_notes"
      ],
      "properties": {
        "iso3": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "name": {"type": "string", "pattern": "\\S"},
        "aliases": {
          "type": "array",
          "items": {"type": "string", "pattern": "\\S"},
          "uniqueItems": true
        },
        "status": {"const": "approved"},
        "reviewer": {"type": "string", "pattern": "\\S"},
        "reviewed_on": {"type": "string", "format": "date"},
        "review_due": {"type": "string", "format": "date"},
        "dossier_path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])source_documents(?:[\\\\/]|$))\\S+$"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}-E-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "pathway_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}-P-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "decision_notes": {"type": "string", "pattern": "\\S"}
      }
    },
    "countrySummary1_1Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iso3", "name", "aliases", "status", "reviewer", "reviewed_on",
        "review_due", "dossier_path", "evidence_ids", "pathway_ids",
        "decision_notes", "selection_aliases"
      ],
      "properties": {
        "iso3": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "name": {"type": "string", "pattern": "\\S"},
        "aliases": {
          "type": "array",
          "items": {"type": "string", "pattern": "\\S"},
          "uniqueItems": true
        },
        "status": {"enum": ["reviewed", "approved"]},
        "reviewer": {"type": "string", "pattern": "\\S"},
        "reviewed_on": {"type": "string", "format": "date"},
        "review_due": {"type": "string", "format": "date"},
        "dossier_path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])source_documents(?:[\\\\/]|$))\\S+$"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}-E-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "pathway_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}-P-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "decision_notes": {"type": "string", "pattern": "\\S"},
        "selection_aliases": {
          "$ref": "profile.schema.json#/$defs/selectionAliases"
        }
      }
    },
    "countrySummary1_1Promoted": {
      "allOf": [
        {"$ref": "#/$defs/countrySummary1_1Candidate"},
        {"properties": {"status": {"const": "approved"}}}
      ]
    },
    "evidence1_0": {
      "allOf": [
        {"$ref": "evidence.schema.json#/$defs/evidence"},
        {
          "properties": {
            "review_status": {"const": "approved"},
            "review_date": {"type": "string", "format": "date"}
          }
        },
        {
          "not": {
            "anyOf": [
              {"required": ["evidence_class"]},
              {"required": ["administrative_level"]},
              {"required": ["ecological_level"]},
              {"required": ["refresh_tier"]},
              {"required": ["review_due"]}
            ]
          }
        }
      ]
    },
    "evidence1_1Fields": {
      "required": [
        "evidence_class", "administrative_level", "ecological_level",
        "refresh_tier", "review_due"
      ]
    },
    "evidence1_1Candidate": {
      "allOf": [
        {"$ref": "evidence.schema.json#/$defs/evidence"},
        {"$ref": "#/$defs/evidence1_1Fields"},
        {
          "properties": {
            "review_status": {"enum": ["reviewed", "approved"]},
            "review_date": {"type": "string", "format": "date"}
          }
        }
      ]
    },
    "evidence1_1Approved": {
      "allOf": [
        {"$ref": "evidence.schema.json#/$defs/evidence"},
        {"$ref": "#/$defs/evidence1_1Fields"},
        {
          "properties": {
            "review_status": {"const": "approved"},
            "review_date": {"type": "string", "format": "date"}
          }
        }
      ]
    },
    "pathwayCandidate": {
      "allOf": [
        {"$ref": "pathway.schema.json#/$defs/pathway"},
        {
          "properties": {
            "review_status": {"enum": ["reviewed", "approved"]},
            "review_date": {"type": "string", "format": "date"}
          }
        }
      ]
    },
    "pathwayApproved": {
      "allOf": [
        {"$ref": "pathway.schema.json#/$defs/pathway"},
        {
          "properties": {
            "review_status": {"const": "approved"},
            "review_date": {"type": "string", "format": "date"}
          }
        }
      ]
    }
  }
}
